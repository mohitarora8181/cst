# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma separated list of allowed browser origins (the Next.js app)
CLIENT_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/castlab

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Required to self-register an Agency (admin) account
AGENCY_INVITE_CODE=CASTLAB-AGENCY-2026

# ── Media ────────────────────────────────────────────
# Get a free key at https://api.imgbb.com/
IMGBB_API_KEY=

# ── Seed (npm run seed) ──────────────────────────────
SEED_AGENCY_EMAIL=agency@castlab.dev
SEED_AGENCY_PASSWORD=Agency@123
